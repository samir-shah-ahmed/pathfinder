<?xml version="1.0"?>
<!-- Visualization geometry only. Dimensions are illustrative; not a contact dynamics model. -->
<robot name="pathfinder_research">
  <material name="frame_blue"><color rgba="0.08 0.45 0.85 1"/></material>
  <material name="rubber"><color rgba="0.12 0.12 0.14 1"/></material>
  <link name="base_link">
    <visual><origin xyz="0.55 0 0.65"/><geometry><box size="1.1 0.06 0.08"/></geometry><material name="frame_blue"/></visual>
  </link>
  <link name="rear_wheel">
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.34" length="0.04"/></geometry><material name="rubber"/></visual>
  </link>
  <joint name="rear_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_wheel"/><origin xyz="0 0 0.34"/><axis xyz="0 1 0"/></joint>
  <link name="steering_link">
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.04 0.04 0.4"/></geometry><material name="frame_blue"/></visual>
  </link>
  <joint name="steering_joint" type="revolute"><parent link="base_link"/><child link="steering_link"/><origin xyz="1.1 0 0.34"/><axis xyz="0 0 1"/><limit lower="-0.55" upper="0.55" effort="1" velocity="1.5"/></joint>
  <link name="front_wheel">
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.34" length="0.04"/></geometry><material name="rubber"/></visual>
  </link>
  <joint name="front_wheel_joint" type="continuous"><parent link="steering_link"/><child link="front_wheel"/><axis xyz="0 1 0"/></joint>
  <link name="imu_link"/>
  <joint name="imu_mount" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0.55 0 0.65"/></joint>
  <link name="camera_link"/>
  <joint name="camera_mount" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="1 0 0.9"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="-1.57079632679 0 -1.57079632679"/></joint>
</robot>
